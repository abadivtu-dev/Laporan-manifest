# Google Sheets API
# Path ke file JSON Service Account (download dari Google Cloud Console)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Daftar ID spreadsheet manifest bulanan (urut dari bulan terdekat ke terjauh)
# Format: id_bulan_juni,id_bulan_juli,id_bulan_agustus
SPREADSHEET_MONTHLY_IDS=13xpBBk1_fPxlDO998kc68ERlGzqjgiP0yCEdiNgP9A0

# ID spreadsheet BIG DATA INVOICE (database pemindahan jamaah)
INVOICE_SPREADSHEET_ID=179bhJ8t29IlR0ThZidJFz43cocBF2ODYFaO4GLaBX14

# WhatsApp
# Group JID (format: 628xxxxxxxxxx-xxxxxx@g.us)
# Cara dapetin: jalanin bot, liat log grup yang tersedia
WA_GROUP_JID=
WA_GROUP_NAME=Laporan Manifest Umroh

# Schedule
REPORT_TIME=21:00
TZ=Asia/Jakarta

# Rate Limiting (dalam milidetik)
WA_MIN_DELAY_MS=4000
WA_MAX_DELAY_MS=8000

# Pipeline
MAX_SPREADSHEET_RETRY=3
MAX_PAKET_RETRY=3
MAX_WA_SEND_RETRY=3
PIPELINE_TIMEOUT_MS=1800000

# Logging (info | debug | warn | error)
LOG_LEVEL=info
