<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 11px;
    color: #222;
    background: #fff;
    padding: 8px;
  }
  .report-container {
    max-width: 1200px;
    margin: 0 auto;
    border: 1px solid #ccc;
    border-radius: 4px;
    overflow: hidden;
  }
  .seat-info {
    background: #e8f0fe;
    padding: 8px 10px;
    font-size: 11px;
    border-bottom: 1px solid #ccc;
    line-height: 1.6;
  }
  .seat-info strong {
    display: inline-block;
    min-width: 80px;
  }
  .seat-info .tag {
    display: inline-block;
    background: #1a73e8;
    color: #fff;
    padding: 1px 6px;
    border-radius: 3px;
    font-size: 10px;
    font-weight: 700;
    margin-right: 4px;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    background: #fff;
  }
  th {
    background: #1a73e8;
    color: #fff;
    font-weight: 600;
    font-size: 10px;
    text-align: center;
    padding: 6px 4px;
    white-space: nowrap;
    border-right: 1px solid #1557b0;
  }
  th:last-child { border-right: none; }
  td {
    padding: 4px 5px;
    border-bottom: 1px solid #e8e8e8;
    border-right: 1px solid #eee;
    font-size: 11px;
    white-space: nowrap;
  }
  td:last-child { border-right: none; }
  tr:nth-child(even) td {
    background: #fafafa;
  }
  .text-right { text-align: right; }
  .text-center { text-align: center; }
  .col-no { width: 35px; text-align: center; }
  .col-id { width: 55px; text-align: center; }
  .col-nik { width: 130px; font-family: 'Consolas', monospace; font-size: 10px; }
  .col-identitas { width: 70px; text-align: center; font-size: 10px; }
  .col-nama { min-width: 150px; }
  .col-status { width: 75px; text-align: center; }
  .col-ket { width: 90px; font-size: 10px; }
  .col-hotel { width: 100px; font-size: 10px; }
  .col-kamar { width: 70px; text-align: center; font-size: 10px; }
  .col-total { width: 110px; text-align: right; font-family: 'Consolas', monospace; font-size: 10px; }
  .col-kurang { width: 100px; text-align: right; font-family: 'Consolas', monospace; font-size: 10px; }
  .badge {
    display: inline-block;
    padding: 1px 6px;
    border-radius: 3px;
    font-size: 10px;
    font-weight: 600;
  }
  .badge-done { background: #e6f4ea; color: #137333; }
  .badge-notyet { background: #fef7e0; color: #b06000; }
  .badge-other { background: #fce8e6; color: #c5221f; }
  .footer {
    background: #f1f3f4;
    padding: 6px 10px;
    font-size: 10px;
    color: #555;
    border-top: 1px solid #ccc;
    display: flex;
    justify-content: space-between;
  }
  .page-label {
    text-align: center;
    font-size: 10px;
    color: #888;
    padding: 4px;
    background: #f8f9fa;
    border-bottom: 1px solid #ddd;
  }
  .no-data {
    text-align: center;
    padding: 16px;
    color: #999;
    font-style: italic;
  }
</style>
</head>
<body>
<div class="report-container">
  <div class="seat-info">
    <div>
      <strong>Kode Paket:</strong> <span class="tag">{{kodePaket}}</span>
      <strong style="margin-left:16px">Paket:</strong> {{namaPaket}}
    </div>
    <div>
      <strong>Jml. Seat:</strong> {{jumlahSeat}}
      <strong style="margin-left:12px">Sisa Seat:</strong> {{sisaSeat}}
      <strong style="margin-left:16px">Tgl:</strong> {{tanggal}}
      <strong style="margin-left:12px">Maskapai:</strong> {{maskapai}}{{#if asal}} | {{asal}} &rarr; {{tujuan}}{{/if}}
    </div>
    {{#if rute}}
    <div style="font-size:10px;color:#555">{{rute}}</div>
    {{/if}}
  </div>

  {{#if pageLabel}}
  <div class="page-label">{{pageLabel}}</div>
  {{/if}}

  <table>
    <thead>
      <tr>
        <th class="col-no">NO</th>
        <th class="col-id">ID REG</th>
        <th class="col-nik">NIK</th>
        <th class="col-identitas">IDENTITAS</th>
        <th class="col-nama">NAMA</th>
        <th class="col-status">STATUS PASPOR</th>
        <th class="col-ket">KET PASPOR</th>
        <th class="col-hotel">HOTEL MAKKAH</th>
        <th class="col-hotel">HOTEL MADINAH</th>
        <th class="col-kamar">KAMAR</th>
        <th class="col-total">TOTAL BAYAR</th>
        <th class="col-kurang">KURANG BAYAR</th>
      </tr>
    </thead>
    <tbody>
      {{#if rows.length}}
        {{#each rows}}
        <tr>
          <td class="col-no">{{noJamaah}}</td>
          <td class="col-id">{{idRegister}}</td>
          <td class="col-nik">{{nik}}</td>
          <td class="col-identitas">{{jenisIdentitas}}</td>
          <td class="col-nama">{{nama}}</td>
          <td class="col-status">{{{statusBadge}}}</td>
          <td class="col-ket">{{keteranganPaspor}}</td>
          <td class="col-hotel">{{hotelMakkah}}</td>
          <td class="col-hotel">{{hotelMadinah}}</td>
          <td class="col-kamar">{{kamar}}</td>
          <td class="col-total">{{totalPembayaran}}</td>
          <td class="col-kurang">{{kurangBayar}}</td>
        </tr>
        {{/each}}
      {{else}}
        <tr><td colspan="12" class="no-data">Belum ada data jamaah</td></tr>
      {{/if}}
    </tbody>
  </table>

  <div class="footer">
    <span>Total Jamaah: {{totalJamaah}} | Sisa Seat: {{sisaSeat}}</span>
    <span>{{timestamp}}</span>
  </div>
</div>
</body>
</html>
